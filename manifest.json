{
  "id": "totp",
  "name": "TOTP",
  "version": "1.0.0",
  "description": "Two-factor sign in with a code from an authenticator app, with backup codes.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-TOTP",
  "docs": "https://docs.termix.site/plugins/totp",
  "category": "Access & Security",
  "icon": "ShieldCheck",
  "features": [
    "Works with any authenticator app",
    "Backup codes in case you lose your phone",
    "More than one device"
  ],
  "engine": {
    "termix": ">=26.10.0",
    "api": "^1.2"
  },
  "capabilities": [
    "db:own",
    "secrets:own",
    "network:serve",
    "auth:provide",
    "ui:surface",
    "db:core-refs"
  ],
  "contributes": {
    "auth": {
      "secondFactors": ["totp"]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"],
  "desktop": "server"
}
